 <LayoutMultiFrame resizeMode="0" html="Description des strates&#xa;&lt;br>&lt;br>&#xa;&lt;b>Strate arborescente&lt;/b> :&#xa;&lt;br>&#xa;Correspond à toutes les espèces&#xa;ligneuses de plus de 4 mètres de&#xa;hauteur.&#xa;&lt;br>&lt;br>&#xa;&lt;b>Strate arbustive&lt;/b> : &#xa;&lt;br>&#xa;Correspondaux espèces ligneuses de moins&#xa;de 4 mètres de hauteur.&#xa;&lt;br>&#xa;&lt;br>&#xa;&lt;b>Strate non-ligneuse&lt;/b> : &#xa;&lt;br>&#xa;Toute la&#xa;végétation non incluse dans les autres strates (herbacée,&#xa;muscinale, etc.)" useSmartBreaks="true" evaluateExpressions="true" maxBreakDistance="10" templateUuid="{a4b8d625-f934-43ea-a2c3-90f5e7fba4ce}" type="65648" stylesheet="body { margin: 0 2.08333;line-height: 122%;color: rgba(0,0,0,1.0000);font-family: MS Shell Dlg 2;font-style: normal;font-weight: 400;font-size: 14.6991px;text-align: left; }" uuid="{a4b8d625-f934-43ea-a2c3-90f5e7fba4ce}" contentMode="1" url="" stylesheetEnabled="true">
